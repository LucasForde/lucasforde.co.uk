---
import "../styles/global.css";
import Loader from "../components/Loader.astro";
import Hero from "../components/Hero.astro";
import FixedScene from "../components/FixedScene.astro";
import Intro from "../components/Intro.astro";
import ContactHeading from "../components/ContactHeading.astro";
import Contact from "../components/Contact.astro";
import { STATIC_LAYOUT_MEDIA_QUERY, STATIC_LAYOUT_USER_AGENT_TOKENS } from "../scripts/static-layout";

const title = "Lucas Forde | Web Design and Development | Tunbridge Wells";
const description = "Lucas Forde is a freelance web designer and developer in Tunbridge Wells, offering website design, improvements, managed hosting and ongoing support.";
const canonicalUrl = new URL("/", Astro.site).href;
const personId = `${canonicalUrl}#lucas-forde`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${canonicalUrl}#website`,
      name: "Lucas Forde",
      url: canonicalUrl,
      description,
      inLanguage: "en-GB",
      publisher: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "Lucas Forde",
      url: canonicalUrl,
      jobTitle: "Freelance web designer and developer",
      description,
      sameAs: [
        "https://www.linkedin.com/in/lucasforde/",
        "https://github.com/LucasForde",
      ],
    },
  ],
};
const staticLayoutUserAgentTokens = STATIC_LAYOUT_USER_AGENT_TOKENS;
const staticLayoutMediaQuery = STATIC_LAYOUT_MEDIA_QUERY;
---

<!doctype html>
<html lang="en" class="is-loading">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script define:vars={{ staticLayoutMediaQuery, staticLayoutUserAgentTokens }}>
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }

      scrollTo(0, 0);

      const userAgent = navigator.userAgent.toLowerCase();
      const matchesStaticLayoutUserAgent = staticLayoutUserAgentTokens.some((token) => userAgent.includes(token));
      const staticLayoutQuery = matchMedia(staticLayoutMediaQuery);

      if (matchesStaticLayoutUserAgent || staticLayoutQuery.matches) {
        document.documentElement.classList.add("is-static-layout");
        document.documentElement.classList.remove("is-loading");
      }
    </script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="google-site-verification" content="4ekPkqUgAg1MzQnLCZxqd2duRcxTQTkQVVDWY0Uecy0" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lucas Forde" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="is-loading">
    <Loader />

    <main class="site" data-site>
      <Hero />
      <FixedScene />
      <Intro />
      <ContactHeading />
      <Contact />
    </main>

    <script>
      import "../scripts/loader.ts";
      import "../scripts/scroll.ts";
    </script>
    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "827c404ff7704328a9a52b24be5c8b24"}'
    ></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
