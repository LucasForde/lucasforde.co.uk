---
const year = new Date().getFullYear();
---

<section class="panel panel--contact" data-contact-section aria-labelledby="contact-details-heading">
  <article class="copy copy--contact">
    <header class="contact-header">
      <div>
        <p class="contact-eyebrow">Get in touch</p>
        <h2 id="contact-details-heading">Let's discuss your website.</h2>
      </div>
      <p>For a new project, improvements to an existing site or managed hosting, contact me directly.</p>
    </header>

    <div class="contact-methods" aria-label="Contact details">
      <div class="contact-method">
        <p class="contact-method__label">Email</p>
        <a href="mailto:lucas@lucasforde.co.uk">lucas@lucasforde.co.uk</a>
      </div>
      <div class="contact-method">
        <p class="contact-method__label">Phone</p>
        <a href="tel:+447539498166">07539 498166</a>
      </div>
      <div class="contact-method">
        <p class="contact-method__label">LinkedIn</p>
        <a href="https://www.linkedin.com/in/lucas-forde-7a04471b9/" target="_blank" rel="noopener noreferrer">View profile</a>
      </div>
    </div>
  </article>

  <footer class="site-footer">
    <span>&copy; Lucas Forde {year}</span>
  </footer>
</section>
